{
  "manifest_path": "data/real_scene/manifest.json",
  "bands": ["B02", "B03", "B04", "B08"],
  "year1": 2023,
  "year2": 2024,
  "min_valid_obs": 4,
  "composite_doy_range": [150, 260],
  "nodata": -9999.0,

  "use_scl": true,
  "scl_invalid_codes": [0, 1, 3, 8, 9, 10, 11],
  "cloud_dilate_px": 2,
  "fallback_cloud_thr": 0.55,

  "normalize": true,
  "norm_iter": 3,
  "norm_sigma": 2.0,

  "band_weights": null,
  "threshold_method": "otsu",
  "threshold_percentile": 99.0,
  "threshold_min": 0.03,

  "min_patch_px": 6,
  "strong_patch_px": 60,
  "min_coherence": 0.55,
  "texture_max_sigma": 0.06,
  "texture_window": 5,
  "morph_close_px": 1,
  "morph_open_px": 1,

  "samples_csv": "data/real_scene/samples.csv",
  "rf_trees": 200,
  "smooth_class_px": 1,

  "class_names": {
    "1": "水体",
    "2": "林地",
    "3": "草地",
    "4": "耕地",
    "5": "建设用地",
    "6": "裸地"
  },
  "out_dir": "outputs_real",
  "pixel_area_m2": 100.0,
  "scene_crs": "EPSG:32650",
  "make_figures": true,
  "write_intermediate": true
}
